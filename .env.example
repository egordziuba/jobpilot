# Скопируй этот файл в .env и впиши значения. Файл .env никому не отправляй.
# Пароль приложения Google: https://myaccount.google.com/apppasswords (нужна двухэтапная проверка)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
# Необязательно, только если в config.toml [llm] enabled = true
ANTHROPIC_API_KEY=
